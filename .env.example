PORT=4000
NODE_ENV=development

# From Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# From Supabase dashboard > Settings > Database — use the "Transaction" pooler (PgBouncer) connection string.
# For local development against docker-compose.yml's `db` service instead
# (recommended to get started quickly — includes mock titiktemu-analytics
# data via supabase/migrations/002+003), use:
#   postgresql://postgres:postgres@localhost:5433/titiktemu
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS whitelist — comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Redis, provisioned by docker-compose.yml's `redis` service. Not yet
# consumed by application code (planned for vector tile/session caching).
REDIS_URL=redis://localhost:6379

# AI Chatbot (POST /api/chat) provider. "gemini" | "openai" | "claude" --
# only the selected provider's key below needs to be set; without it, the
# chatbot returns a stub answer instead of calling the real API.
LLM_PROVIDER=gemini

# Gemini API key -- from Google AI Studio, https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# OpenAI API key -- from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude) API key -- from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-haiku-latest
