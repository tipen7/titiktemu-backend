PORT=4000
NODE_ENV=development

# From Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# From Supabase dashboard > Settings > Database — use the "Transaction" pooler (PgBouncer) connection string
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS whitelist — comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# AI Chatbot -- from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash