PORT=4000
NODE_ENV=development

# From Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# From Supabase dashboard > Settings > Database — use the "Transaction" pooler (PgBouncer) connection string
DATABASE_URL=postgresql://postgres.your-project-ref:your_db_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS whitelist — comma-separated origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# Redis, provisioned by docker-compose.yml's `redis` service. Not yet
# consumed by application code (planned for vector tile/session caching).
REDIS_URL=redis://localhost:6379

# Gemini API key (Google AI Studio) for POST /api/narrative's LLM narrative
# orchestration (Asumsi A5: narrative text only, never numeric calculation).
# If unset, the endpoint falls back to MockGeminiAdapter — a canned string,
# no external call. GEMINI_MODEL defaults to "gemini-2.5-flash" if unset.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Base URL of the ML team's XGBoost scoring service (FastAPI), once it
# exists. If unset, POST /api/score/* falls back to MockScoringAdapter
# (deterministic placeholder values, not a model).
ML_SCORING_SERVICE_URL=http://localhost:8000